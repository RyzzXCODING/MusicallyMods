{
  "schemaVersion": 1,
  "id": "musicallymods",
  "version": "${version}",
  "name": "MusicallyMods",
  "description": "A lightweight in-game music platform: search free music sources, play preview/direct streams, and read a customizable lyrics overlay.",
  "authors": [
    "Alpoyy"
  ],
  "contact": {
    "homepage": "https://github.com/RyzzXCODING/MusicallyMods",
    "sources": "https://github.com/RyzzXCODING/MusicallyMods"
  },
  "license": "MIT",
  "icon": "assets/musicallymods/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "cc.alpoyy.musicallymods.client.MusicallyModsClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.6"
  },
  "suggests": {
    "modmenu": "*"
  }
}
